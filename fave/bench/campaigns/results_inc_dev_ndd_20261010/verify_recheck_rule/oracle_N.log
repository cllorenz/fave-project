                logging.getLogger("test_incremental_apkeep"))):
            engine = make()
            per_update = []
            with InProcessFaVe(engine) as fave:
                fave.replay(prefix)
                engine.track_affected(True)
                cache = inc.VerdictCache(fave, engine, checks)
                cache.full()
