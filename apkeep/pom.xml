<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.ants</groupId>
  <artifactId>apkeep</artifactId>
  <version>1.0.0</version>
  <name>apkeep</name>

  <!-- FaVe fork: upstream set no Java version, so the compiler plugin defaulted
       to 1.5, which JDK 11 (APKeep's documented target) rejects. Pin to 11. -->
  <properties>
      <maven.compiler.release>11</maven.compiler.release>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
      <plugins>
          <!-- FaVe fork: pin a modern compiler plugin. Maven's super-POM binds
               maven-compiler-plugin 3.1, which predates the `release` option and
               defaults to Java 1.5 (rejected by JDK 11). 3.11.0 honors release=11. -->
          <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-compiler-plugin</artifactId>
              <version>3.11.0</version>
          </plugin>
          <!-- FaVe fork: APKeep shipped no tests at all. Add a JUnit 5 harness
               so the reachability-critical core (forwarding/ACL/AP/Network/
               ReachabilityChecker) is covered before we extend it; see
               TESTING_STRATEGY_JAVA.md. Tests run in the `test` phase of the
               existing `mvn package` (apkeep_smoke.sh), so the integration tier
               gates on them. -->
          <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <version>3.2.5</version>
          </plugin>
          <!-- Coverage report for the core packages (ratchet floor added once a
               baseline exists; see TESTING_STRATEGY_JAVA.md). -->
          <plugin>
              <groupId>org.jacoco</groupId>
              <artifactId>jacoco-maven-plugin</artifactId>
              <version>0.8.12</version>
              <executions>
                  <execution>
                      <id>prepare-agent</id>
                      <goals><goal>prepare-agent</goal></goals>
                  </execution>
                  <execution>
                      <id>report</id>
                      <phase>test</phase>
                      <goals><goal>report</goal></goals>
                  </execution>
                  <!-- Ratchet floor: a regression backstop, not a quality target.
                       The whole-bundle figure is dragged down by code we
                       deliberately do not test (snapshot loader, MPLS, IPv6
                       scaffolding, alternate AP impls); the meaningful coverage is
                       on the critical path (ReachabilityChecker ~94%, Network ~66%,
                       APKeeper ~56%). Raise this as later phases add tests; never
                       lower it. Bound to `test` so `mvn package` (apkeep_smoke.sh)
                       enforces it. -->
                  <execution>
                      <id>check</id>
                      <phase>test</phase>
                      <goals><goal>check</goal></goals>
                      <configuration>
                          <rules>
                              <rule>
                                  <element>BUNDLE</element>
                                  <limits>
                                      <limit>
                                          <counter>INSTRUCTION</counter>
                                          <value>COVEREDRATIO</value>
                                          <minimum>0.30</minimum>
                                      </limit>
                                  </limits>
                              </rule>
                          </rules>
                      </configuration>
                  </execution>
              </executions>
          </plugin>
          <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-shade-plugin</artifactId>
              <version>3.2.4</version>
              <executions>
                  <execution>
                      <phase>package</phase>
                      <goals>
                          <goal>shade</goal>
                      </goals>
                      <configuration>
                          <createDependencyReducedPom>false</createDependencyReducedPom>
                          <transformers>
                              <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                  <manifestEntries>
                                      <Main-Class>apkeep.main.Main</Main-Class>
                                  </manifestEntries>
                              </transformer>
                              <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                          </transformers>
                      </configuration>
                  </execution>
              </executions>
          </plugin>
      </plugins>
  </build>
  
  <!-- FaVe fork: JDD is not on Maven Central, and JitPack only serves its .pom
       (never a .jar - JDD is a Gradle/Ant project that produces no resolvable
       Maven artifact). Upstream's `mvn package` therefore could not resolve JDD
       at all. We vendor a JDD jar (built from the author's Bitbucket source) in
       an in-tree file repository so the build is hermetic (no network/JitPack).
       See local-maven-repo/README for provenance (zlib/public-domain license). -->
  <repositories>
      <repository>
          <id>fave-vendored-jdd</id>
          <url>file://${project.basedir}/local-maven-repo</url>
      </repository>
  </repositories>

  <dependencies>
  		<dependency>
		    <groupId>org.bitbucket.vahidi</groupId>
		    <artifactId>JDD</artifactId>
		    <!-- FaVe fork: upstream pinned 108, but that tag was never published on
		         the JDD repo (tags start at 109). 111 is the nearest tag from the
		         same author (2019); the BDD API used here (and/not/ref/deref/exists/
		         or/diff) is long-stable across it. Vendored in local-maven-repo/. -->
		    <version>111</version>
		</dependency>
		<dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>3.20.0</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
	        <artifactId>fastjson</artifactId>
	        <version>1.2.70</version>
	    </dependency>
	    <dependency>
	        <groupId>org.junit.jupiter</groupId>
	        <artifactId>junit-jupiter</artifactId>
	        <version>5.10.2</version>
	        <scope>test</scope>
	    </dependency>
  </dependencies>
</project>